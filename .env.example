# Copy this file to .env and fill in the values from your Firebase project.
# .env is gitignored. Vars must be prefixed PUBLIC_ (Vite inlines these into
# the client bundle — do NOT put real secrets here).

# From Firebase console → Project settings → Your apps → SDK setup
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Admin password for the /admin page. Falls back to "bemmy" if unset.
PUBLIC_ADMIN_PASSWORD=
